# Konfigurasi WeaBot-Rust

# Prefix untuk perintah bot (default: !)
BOT_PREFIX="!"

# Nomor telepon bot untuk Pairing Code 8-Digit (kosongkan jika ingin scan QR)
# Format internasional tanpa tanda tambah (+) atau spasi, contoh: 628123456789
BOT_PHONE=""

# Lokasi penyimpanan database sesi WhatsApp (SQLite)
DATABASE_PATH="sessions/weabot.db"

# Level logging (info, debug, warn, error)
RUST_LOG="info"
